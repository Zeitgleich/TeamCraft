# Nightly toolchain with cargo-fuzz for fuzz/run.sh. The source is mounted, not copied:
#
#   podman build -f fuzz/Containerfile -t teamcraft-fuzz fuzz/
#
# The base image is pinned by digest, the nightly by date (sanitizer builds need a nightly; bump
# both deliberately).

FROM docker.io/library/rust:1.99.1-trixie@sha256:8a4e90c7946b74626488b1446f712c0fe0ed1a596cbd3d871684bc9c5433ae07
ARG NIGHTLY=nightly-2026-10-20
RUN rustup toolchain install ${NIGHTLY} --profile minimal --component rust-src \
 && rustup default ${NIGHTLY} \
 && cargo install cargo-fuzz@0.13.2 --locked
ENV RUSTUP_TOOLCHAIN=${NIGHTLY} \
    SQLX_OFFLINE=true \
    CARGO_TARGET_DIR=/target \
    CARGO_INCREMENTAL=0
WORKDIR /src/fuzz
