{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id AS \"id!\", c.kind AS \"kind!\", o.user_id AS \"other?\"\n         FROM memberships m\n         JOIN conversations c ON c.id = m.conversation_id AND c.kind IN ('dm', 'group')\n         LEFT JOIN memberships o ON o.conversation_id = c.id AND o.user_id <> m.user_id\n         WHERE m.user_id = $1\n         ORDER BY c.id",
