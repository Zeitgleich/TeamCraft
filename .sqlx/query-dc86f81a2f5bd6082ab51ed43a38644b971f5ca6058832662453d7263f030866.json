  "query": "SELECT m.group_id, m.user_id, COALESCE(u.idp_display_name, u.display_name) AS \"display_name!\"\n         FROM scim_group_members m JOIN users u ON u.id = m.user_id\n         WHERE m.group_id = ANY($1) AND u.deleted_at IS NULL ORDER BY m.group_id, m.user_id",
