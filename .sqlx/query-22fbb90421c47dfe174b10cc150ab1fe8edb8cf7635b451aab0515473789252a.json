  "query": "SELECT m.user_id, m.last_read_message_id\n         FROM memberships m\n         LEFT JOIN user_notification_settings s ON s.user_id = m.user_id\n         WHERE m.conversation_id = $1 AND COALESCE(s.send_read_receipts, $2)\n         ORDER BY m.user_id",
