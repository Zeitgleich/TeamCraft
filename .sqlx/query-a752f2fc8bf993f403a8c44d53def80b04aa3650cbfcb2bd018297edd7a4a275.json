{
  "db_name": "PostgreSQL",
  "query": "SELECT id, actor_user_id, action, target_kind, target_id, detail::text AS \"detail!\", created_at\n         FROM audit_log\n         WHERE ($1::bigint IS NULL OR actor_user_id = $1)\n           AND ($2::text IS NULL OR action = $2)\n           AND ($3::text IS NULL OR target_kind = $3)\n           AND ($4::bigint IS NULL OR target_id = $4)\n           AND ($5::timestamptz IS NULL OR created_at >= $5)\n           AND ($6::timestamptz IS NULL OR created_at < $6)\n           AND ($7::bigint IS NULL OR id < $7)\n         ORDER BY id DESC LIMIT $8",
