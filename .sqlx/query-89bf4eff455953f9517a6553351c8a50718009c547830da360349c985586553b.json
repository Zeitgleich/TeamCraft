  "db_name": "PostgreSQL",
  "query": "SELECT m.user_id, m.last_delivered_message_id,\n                COALESCE(s.send_delivery_receipts, $2) AS \"is_sharing!\"\n         FROM memberships m\n         LEFT JOIN user_notification_settings s ON s.user_id = m.user_id\n         WHERE m.conversation_id = $1\n         ORDER BY m.user_id",
