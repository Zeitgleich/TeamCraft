{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.conversation_id, m.epoch, m.kind, m.sender_device_id, m.recipient_device_id, m.payload\n         FROM mls_messages m\n         WHERE m.conversation_id = $1\n           AND ($2::bigint IS NULL OR m.id > $2)\n           AND ($3::bigint IS NULL OR m.id >= $3)\n           AND (m.kind <> 'welcome' OR EXISTS (\n                 SELECT 1 FROM devices d WHERE d.id = m.recipient_device_id AND d.user_id = $4))\n         ORDER BY m.id ASC LIMIT $5",
