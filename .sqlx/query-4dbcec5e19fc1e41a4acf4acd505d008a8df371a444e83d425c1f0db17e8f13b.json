  "query": "SELECT id, username, email, display_name, COALESCE(idp_display_name, display_name) AS \"idp_display_name!\", kind, oidc_role, COALESCE(oidc_role_seen, oidc_role) AS seen_role, created_at, organization, deactivated_at IS NOT NULL AS \"is_deactivated!\", deleted_at IS NOT NULL AS \"is_deleted!\",\n                default_memberships_at IS NULL AS \"is_awaiting_defaults!\",\n                EXISTS (SELECT 1 FROM role_losses WHERE role_losses.user_id = users.id) AS \"has_role_loss!\",\n                awaiting_first_sign_in_since IS NOT NULL AS \"is_awaiting_first_sign_in!\"\n         FROM users WHERE oidc_issuer = $1 AND oidc_subject = $2",
