  "query": "SELECT b.user_id, b.name, b.description, b.created_at, b.revoked_at IS NOT NULL AS \"is_revoked!\",\n                COALESCE(u.deactivation_reason = 'creator_deactivated', false) AS \"is_paused!\"\n         FROM bots b JOIN users u ON u.id = b.user_id ORDER BY b.created_at, b.user_id",
