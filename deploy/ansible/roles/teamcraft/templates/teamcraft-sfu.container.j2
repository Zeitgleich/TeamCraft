# Managed by Ansible (roles/teamcraft). Runs rootless as tc-sfu.
[Unit]
Description=TeamCraft SFU (WebTransport media forwarding)

[Container]
Image={{ teamcraft_images.sfu }}
Pull=missing
ContainerName=teamcraft-sfu
# Host network: rootless user-mode networking (pasta) adds per-packet overhead that matters for
# media forwarding.
Network=host
# Certificate exported by caddy's timer; tc-sfu reads it via group tc-certs.
Volume={{ teamcraft_cert_dir }}:/certs:ro
Volume=/home/tc-sfu/config/call-signing.pub.pem:/etc/teamcraft/call-signing.pub.pem:ro,Z
GroupAdd=keep-groups
Secret=sfu_registration_token,type=env,target=TEAMCRAFT_SFU_REGISTRATION_TOKEN
# Dual-stack socket: [::] with IPV6_V6ONLY off accepts IPv4 (mapped) and IPv6.
Environment=TEAMCRAFT_SFU_BIND=[::]:{{ teamcraft_ports.sfu }}
# Health and host controls (called by the server): loopback only.
Environment=TEAMCRAFT_SFU_HEALTH_BIND=127.0.0.1:{{ teamcraft_ports.sfu_control }}
Environment=TEAMCRAFT_SFU_CERT=/certs/sfu.crt
Environment=TEAMCRAFT_SFU_KEY=/certs/sfu.key
Environment=TEAMCRAFT_SFU_JOIN_TOKEN_PUBLIC_KEY=/etc/teamcraft/call-signing.pub.pem
Environment=TEAMCRAFT_SFU_JOIN_TOKEN_ISSUER=https://{{ teamcraft_domain }}
# Join and leave reports go to the internal API over loopback (Caddy refuses /api/internal/).
Environment=TEAMCRAFT_SFU_SERVER_URL=http://127.0.0.1:{{ teamcraft_ports.server }}
Environment=RUST_LOG={{ teamcraft_log_filter }}
Environment=NO_COLOR=1
User=65532
Group=65532
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
RunInit=yes
# Exec form (JSON): the distroless image has no shell for the string form.
HealthCmd=["/usr/local/bin/teamcraft-sfu", "healthcheck"]
HealthInterval=30s
PodmanArgs=--memory={{ teamcraft_memory.sfu }}
LogDriver=journald

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300

[Install]
WantedBy=default.target
