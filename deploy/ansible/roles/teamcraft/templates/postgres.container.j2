# Managed by Ansible (roles/teamcraft). Runs rootless as tc-db.
[Unit]
Description=TeamCraft Postgres

[Container]
Image={{ teamcraft_images.postgres }}
ContainerName=teamcraft-postgres
# Host network inside tc-db's user namespace; listens on loopback only.
Network=host
Exec=postgres -c listen_addresses=127.0.0.1 -c port={{ teamcraft_ports.postgres }}
Volume=postgres-data:/var/lib/postgresql
Secret=postgres_password,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_USER=teamcraft
Environment=POSTGRES_DB=teamcraft
Environment=POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
NoNewPrivileges=true
PodmanArgs=--memory={{ teamcraft_memory.postgres }}
HealthCmd=pg_isready -h 127.0.0.1 -p {{ teamcraft_ports.postgres }} -U teamcraft
HealthInterval=10s
LogDriver=journald

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
