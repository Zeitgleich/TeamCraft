# Managed by Ansible (roles/teamcraft). Runs as tc-sfu: the SFU reads its certificate at start only,
# so a renewed certificate (exported by tc-proxy's timer) restarts it. Running calls reconnect.
[Unit]
Description=Restart the SFU when its certificate changes

[Path]
PathChanged={{ teamcraft_cert_dir }}/sfu.crt

[Install]
WantedBy=default.target
