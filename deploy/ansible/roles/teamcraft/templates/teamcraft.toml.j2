# Managed by Ansible (roles/teamcraft). Secrets come from podman secrets as TEAMCRAFT_* variables.
# Option reference: teamcraft.example.toml in the teamcraft repository; unset options keep its defaults.

[server]
listen_addr = "127.0.0.1:{{ teamcraft_ports.server }}"

[oidc]
issuer = "{{ teamcraft_oidc_issuer }}"
client_id = "{{ teamcraft_oidc_client_id }}"
server_client = "{{ teamcraft_oidc_server_client }}"

[oidc.roles]
owner = "{{ teamcraft_oidc_roles.owner }}"
admin = "{{ teamcraft_oidc_roles.admin }}"
member = "{{ teamcraft_oidc_roles.member }}"
guest = "{{ teamcraft_oidc_roles.guest }}"

[oidc.sync]
is_enabled = {{ teamcraft_oidc_sync_enabled | lower }}

[logging]
filter = "{{ teamcraft_log_filter }}"
format = "json"

# Caddy terminates TLS and sets X-Forwarded-For.
[security]
hsts = true
trust_forwarded_for = true

[storage]
endpoint = "{{ teamcraft_s3_endpoint }}"
region = "{{ teamcraft_s3_region }}"
bucket = "{{ teamcraft_s3_bucket }}"
path_style = {{ teamcraft_s3_path_style | lower }}

{% if teamcraft_web_archive | length > 0 %}
[web]
static_dir = "/srv/teamcraft/web"

{% endif %}
[shares]
public_base_url = "https://{{ teamcraft_domain }}"

[calls]
sfu_url = "https://{{ teamcraft_sfu_domain }}:{{ teamcraft_ports.sfu }}/call"
issuer = "https://{{ teamcraft_domain }}"
signing_key_path = "/run/secrets/call-signing.pem"
sfu_control_url = "http://127.0.0.1:{{ teamcraft_ports.sfu_control }}"

[meetings]
public_base_url = "https://{{ teamcraft_domain }}"
organizer_fallback_address = "{{ teamcraft_mail_from }}"
{% if teamcraft_smtp is defined %}

[meetings.smtp]
host = "{{ teamcraft_smtp.host }}"
port = {{ teamcraft_smtp.port | default(587) }}
security = "{{ teamcraft_smtp.security | default('start_tls') }}"
username = "{{ teamcraft_smtp.username }}"
from_address = "{{ teamcraft_mail_from }}"
{% endif %}

[mail]
public_base_url = "https://{{ teamcraft_domain }}"
{% if teamcraft_smtp is defined %}

[mail.smtp]
host = "{{ teamcraft_smtp.host }}"
port = {{ teamcraft_smtp.port | default(587) }}
security = "{{ teamcraft_smtp.security | default('start_tls') }}"
username = "{{ teamcraft_smtp.username }}"
from_address = "{{ teamcraft_mail_from }}"
{% endif %}

[push]
vapid_subject = "mailto:{{ teamcraft_acme_email }}"
