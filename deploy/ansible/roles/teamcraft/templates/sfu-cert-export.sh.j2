#!/bin/sh
# Managed by Ansible (roles/teamcraft). Runs as tc-proxy: copies the SFU certificate that Caddy
# obtained into the shared directory readable by group tc-certs.
set -eu
dir="/home/tc-proxy/caddy-data/caddy/certificates/{{ teamcraft_caddy_issuer_dirs[teamcraft_tls] }}/{{ teamcraft_sfu_domain }}"
dest="{{ teamcraft_cert_dir }}"
[ -f "$dir/{{ teamcraft_sfu_domain }}.crt" ] || exit 0
if cmp -s "$dir/{{ teamcraft_sfu_domain }}.crt" "$dest/sfu.crt"; then exit 0; fi
install -m 0640 -g tc-certs "$dir/{{ teamcraft_sfu_domain }}.crt" "$dest/sfu.crt.new"
install -m 0640 -g tc-certs "$dir/{{ teamcraft_sfu_domain }}.key" "$dest/sfu.key.new"
mv "$dest/sfu.key.new" "$dest/sfu.key"
mv "$dest/sfu.crt.new" "$dest/sfu.crt"
