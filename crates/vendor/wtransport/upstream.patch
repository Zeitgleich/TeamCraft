+    /// Switches the endpoint to a new UDP socket.
+    ///
+    /// All connections of this endpoint continue on the new socket: QUIC connection migration
+    /// moves them to the new local address, after the server validated the new path. This is
+    /// useful when the network changes (e.g., Wi-Fi to cellular) and the old socket can no longer
+    /// reach the server.
+    ///
+    /// On error, the old UDP socket is retained.
+    pub fn rebind(&self, socket: std::net::UdpSocket) -> std::io::Result<()> {
+        self.endpoint.rebind(socket)
+    }
