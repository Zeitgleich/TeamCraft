{
  "build": {
    "beforeBuildCommand": {
      "script": "set CARGO_PROFILE_RELEASE_OPT_LEVEL=s&& set CARGO_PROFILE_RELEASE_LTO=true&& trunk build --release",
      "cwd": "../../crates/teamcraft-ui"
    }
  },
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "German"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "teamcraft"
        ]
      }
    }
  }
}
