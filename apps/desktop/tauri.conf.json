{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeamCraft",
  "version": "0.0.0",
  "identifier": "de.zeitgleich.teamcraft",
  "build": {
    "frontendDist": "../../crates/teamcraft-ui/dist",
    "devUrl": "http://127.0.0.1:8082",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../../crates/teamcraft-ui"
    },
    "beforeBuildCommand": {
      "script": "CARGO_PROFILE_RELEASE_OPT_LEVEL=s CARGO_PROFILE_RELEASE_LTO=true trunk build --release",
      "cwd": "../../crates/teamcraft-ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "publisher": "TeamCraft contributors",
    "copyright": "Copyright (C) TeamCraft contributors. AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/Zeitgleich/TeamCraft",
    "shortDescription": "End-to-end encrypted team chat",
    "longDescription": "Self-hosted business team chat with calls and meetings. Messages are end-to-end encrypted; the server only stores ciphertext.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "packaging/macos/Entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional",
        "depends": [
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0"
        ],
        "recommends": [
          "gnome-keyring",
          "gstreamer1.0-plugins-bad"
        ]
      },
      "rpm": {
        "release": "1",
        "depends": [
          "gstreamer1",
          "gstreamer1-plugins-base"
        ],
        "recommends": [
          "gnome-keyring",
          "gstreamer1-plugins-bad-free"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
