{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeamCraft",
  "version": "0.0.0",
  "identifier": "org.teamcraft.desktop",
  "build": {
    "frontendDist": "../../crates/teamcraft-ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "trunk serve --config ../../crates/teamcraft-ui/Trunk.toml",
    "beforeBuildCommand": "CARGO_PROFILE_RELEASE_OPT_LEVEL=s CARGO_PROFILE_RELEASE_LTO=true trunk build --release --config ../../crates/teamcraft-ui/Trunk.toml"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TeamCraft",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "shortDescription": "End-to-end encrypted team chat",
    "targets": ["deb", "rpm", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
