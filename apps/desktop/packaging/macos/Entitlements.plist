<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: camera and microphone for calls. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- GStreamer.framework is bundled with its own signature and loads plugins at runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Server connection and the loopback listener of the OIDC login (RFC 8252). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Not here: com.apple.developer.focus-status (macOS Focus, #191). It is a profile-backed
       entitlement: a Developer ID build that carries it without an embedded provisioning profile
       is killed at launch. Add it together with the profile; until then the Focus read answers
       "unknown" and never silences. -->
</dict>
</plist>
