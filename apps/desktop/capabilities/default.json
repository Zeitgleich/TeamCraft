{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call: the shell's own commands (listed in build.rs) and event subscriptions. No plugin commands: the webview never opens URLs, shows notifications or runs the updater itself.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-auth-restore",
    "allow-auth-login",
    "allow-auth-cancel",
    "allow-auth-logout",
    "allow-api-get",
    "allow-api-request",
    "allow-api-request-bytes",
    "allow-public-get",
    "allow-core-start",
    "allow-core-status",
    "allow-core-connection",
    "allow-core-network-changed",
    "allow-core-enroll",
    "allow-core-snapshot",
    "allow-core-link-start",
    "allow-core-link-status",
    "allow-core-link-cancel",
    "allow-core-approval-start",
    "allow-core-approval-confirm",
    "allow-core-approval-cancel",
    "allow-core-messages",
    "allow-core-thread",
    "allow-core-action",
    "allow-core-query",
    "allow-core-stop",
    "allow-call-snapshot",
    "allow-call-media-devices",
    "allow-call-action",
    "allow-call-watch-video",
    "allow-call-background-preview",
    "allow-call-unwatch-video",
    "allow-notify-user",
    "allow-withdraw-notifications",
    "allow-os-attention",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-shell-prefs-get",
    "allow-shell-prefs-set",
    "allow-tray-update",
    "allow-set-zoom",
    "allow-update-status",
    "allow-update-check",
    "allow-update-set-preference",
    "allow-update-download",
    "allow-update-restart",
    "allow-update-with-package-manager"
  ]
}
