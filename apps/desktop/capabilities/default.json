{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call: the shell's own commands (listed in build.rs) and event subscriptions. No plugin commands: the webview opens links only through `open_external` (web and mail addresses), shows notifications or runs the updater itself.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-auth-restore",
    "allow-auth-login",
    "allow-auth-login-local",
    "allow-auth-cancel",
    "allow-auth-logout",
    "allow-api-get",
    "allow-api-request",
    "allow-api-request-bytes",
    "allow-public-get",
    "allow-public-asset",
    "allow-avatar-download",
    "allow-avatar-upload",
    "allow-server-state",
    "allow-server-check",
    "allow-server-suggest",
    "allow-server-confirm",
    "allow-server-forget",
    "allow-core-start",
    "allow-core-status",
    "allow-core-connection",
    "allow-core-network-changed",
    "allow-core-enroll",
    "allow-core-snapshot",
    "allow-core-snapshot-changes",
    "allow-core-link-start",
    "allow-core-link-status",
    "allow-core-link-cancel",
    "allow-core-approval-start",
    "allow-core-approval-confirm",
    "allow-core-approval-cancel",
    "allow-core-link-announce",
    "allow-core-link-requests",
    "allow-core-link-request-review",
    "allow-core-link-request-reject",
    "allow-core-messages",
    "allow-core-thread",
    "allow-core-action",
    "allow-core-query",
    "allow-core-attachment",
    "allow-core-stage-file",
    "allow-core-focus",
    "allow-core-stop",
    "allow-core-reset-store",
    "allow-dropped-files-take",
    "allow-dropped-file-read",
    "allow-clipboard-paste-files",
    "allow-clipboard-read-image",
    "allow-call-snapshot",
    "allow-call-media-devices",
    "allow-call-action",
    "allow-call-watch-video",
    "allow-call-background-preview",
    "allow-call-unwatch-video",
    "allow-call-watch-camera",
    "allow-call-unwatch-camera",
    "allow-open-external",
    "allow-notify-user",
    "allow-withdraw-notifications",
    "allow-request-attention",
    "allow-call-window-show",
    "allow-call-window-close",
    "allow-call-window-info",
    "allow-call-window-ready",
    "allow-call-window-action",
    "allow-set-ringtone",
    "allow-os-attention",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-shell-prefs-get",
    "allow-shell-prefs-set",
    "allow-tray-update",
    "allow-set-zoom",
    "allow-update-status",
    "allow-update-check",
    "allow-update-set-preference",
    "allow-update-download",
    "allow-update-restart",
    "allow-update-with-package-manager",
    "allow-window-chrome",
    "allow-window-action"
  ]
}
