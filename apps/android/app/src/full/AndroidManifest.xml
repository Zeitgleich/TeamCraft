<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Google Play: photos and videos come through the system photo picker only, so no media
       library access, also not from a library's manifest (BuildConfig.READS_MEDIA_LIBRARY). -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />

  <application>
    <!-- Firebase is initialized from build settings, not google-services.json (PushBackends.kt). -->
    <meta-data
      android:name="firebase_messaging_auto_init_enabled"
      android:value="false" />

    <!-- Crash reports start by hand, only while the server has them on and the user agrees
         (crash/CrashReports.kt); the SDK's start-up providers never run. -->
    <meta-data
      android:name="io.sentry.auto-init"
      android:value="false" />
    <provider
      android:name="io.sentry.android.core.SentryInitProvider"
      android:authorities="${applicationId}.SentryInitProvider"
      tools:node="remove" />
    <provider
      android:name="io.sentry.android.core.SentryPerformanceProvider"
      android:authorities="${applicationId}.SentryPerformanceProvider"
      tools:node="remove" />

    <service
      android:name=".push.FcmService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
