<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Calls: Telecom integration (Core-Telecom), the microphone and the ongoing-call service. -->
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!-- Rings take over the screen like a phone call (Android 14+: the user can revoke it). -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <!-- Video in calls and scanning the device-link QR code. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />

  <application
    android:name=".TeamCraftApplication"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true"
    android:theme="@style/Theme.TeamCraft">

    <!-- Managed configuration: server address and lock, set by the organization's MDM. -->
    <meta-data
      android:name="android.content.APP_RESTRICTIONS"
      android:resource="@xml/app_restrictions" />

    <!-- One task: the share sheet starts its targets as new documents in tasks of their own
         (NEW_DOCUMENT | MULTIPLE_TASK). Every share left another copy of the app behind, starting cold
         beside the open one, reading its list on the same thread (#1371). "never" overrides both. -->
    <activity
      android:name=".ui.MainActivity"
      android:exported="true"
      android:documentLaunchMode="never"
      android:launchMode="singleTop"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Share text, links, photos and files from other apps into a conversation (picked in the app). -->
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <!-- Links to any instance, from the web client's "Open in the app" (docs/app-links.md). App Links
           of the hosts a build lists are generated: build.gradle.kts, `teamcraft.appLinkHosts`. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="teamcraft" android:host="open" />
      </intent-filter>
      <!-- Direct share: the notes and recent conversations in the system share sheet (#829). -->
      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
    </activity>

    <!-- Reply and mark-as-read from notifications, phone and Android Auto alike. -->
    <receiver
      android:name=".notifications.NotificationActionReceiver"
      android:exported="false" />

    <!-- UnifiedPush distributors deliver here (e2ee.md §7). -->
    <receiver
      android:name=".push.UnifiedPushReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="org.unifiedpush.android.connector.MESSAGE" />
        <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
        <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
        <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
        <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
      </intent-filter>
    </receiver>

    <!-- In-call screen; shown over the lock screen for answered calls. -->
    <activity
      android:name=".calls.CallActivity"
      android:exported="false"
      android:launchMode="singleTask"
      android:showWhenLocked="true"
      android:turnScreenOn="true" />

    <!-- "Decline" on the incoming-call notification. -->
    <receiver
      android:name=".calls.CallActionReceiver"
      android:exported="false" />

    <service
      android:name=".calls.CallService"
      android:exported="false"
      android:foregroundServiceType="phoneCall|microphone|camera" />

    <!-- Android Auto calling: lists conversations to call (Car App Library, category CALLING). -->
    <service
      android:name=".calls.CarCallService"
      android:exported="true">
      <intent-filter>
        <action android:name="androidx.car.app.CarAppService" />
        <category android:name="androidx.car.app.category.CALLING" />
      </intent-filter>
    </service>

    <meta-data
      android:name="androidx.car.app.minCarApiLevel"
      android:value="1" />

    <!-- Android Auto reads and answers messaging notifications. -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />
    <!-- WorkManager starts on first use, off the main thread, not before the first frame
         (TeamCraftApplication is its Configuration.Provider). -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
    <!-- Sealed camera videos for the app's own video export; other apps can't reach it, no plain file. -->
    <provider
      android:name=".ui.media.SealedMediaProvider"
      android:authorities="${applicationId}.sealedmedia"
      android:exported="false" />
    <!-- Opens decrypted downloads in other apps without exposing the rest of the app's files. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.files"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/shared_files" />
    </provider>
  </application>
</manifest>
