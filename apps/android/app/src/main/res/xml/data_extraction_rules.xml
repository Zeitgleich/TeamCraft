<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the store is useless without the Keystore key (e2ee.md §9.2), and
     restoring it elsewhere must go through device linking or recovery. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
