<?xml version="1.0" encoding="utf-8"?>
<!-- The video viewer's player when the app's own AV1 or VP9 decoder plays the video
     (VideoViewer.kt): they draw through OpenGL, the only way libvpx shows 10-bit VP9. The surface
     type can only be set here, not in code. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  app:surface_type="video_decoder_gl_surface_view" />
