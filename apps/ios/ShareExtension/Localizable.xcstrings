{
  "sourceLanguage": "en",
  "strings": {
    "share_copying": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird kopiert …"
          }
        }
      }
    },
    "share_saved_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved for TeamCraft"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für TeamCraft gespeichert"
          }
        }
      }
    },
    "share_saved_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TeamCraft to choose a conversation. It is sent only when you press send there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne TeamCraft, um eine Unterhaltung zu wählen. Gesendet wird erst, wenn du dort auf Senden tippst."
          }
        }
      }
    },
    "share_saved_notification": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to choose a conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um eine Unterhaltung zu wählen."
          }
        }
      }
    },
    "share_failed_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save this"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ließ sich nicht speichern"
          }
        }
      }
    },
    "share_failed_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was saved. Try sharing it again, or check the free space on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts gespeichert. Teile es noch einmal oder prüfe den freien Speicher auf diesem Gerät."
          }
        }
      }
    },
    "share_done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    }
  },
  "version": "1.0"
}
