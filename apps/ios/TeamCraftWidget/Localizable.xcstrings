{
  "sourceLanguage": "en",
  "strings": {
    "widget_name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unread chats"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungelesene Chats"
          }
        }
      }
    },
    "widget_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations with unread messages, and a button for a new message."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen mit ungelesenen Nachrichten und eine Taste für eine neue Nachricht."
          }
        }
      }
    },
    "widget_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unread"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungelesen"
          }
        }
      }
    },
    "widget_caught_up": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're all caught up"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gelesen"
          }
        }
      }
    },
    "widget_locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TeamCraft to see your chats. The app lock hides them here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne TeamCraft, um deine Chats zu sehen. Die App-Sperre verbirgt sie hier."
          }
        }
      }
    },
    "widget_signed_out": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to TeamCraft to see your chats here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei TeamCraft an, um deine Chats hier zu sehen."
          }
        }
      }
    },
    "widget_new_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New message"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Nachricht"
          }
        }
      }
    },
    "widget_unread_count %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unread"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ungelesen"
          }
        }
      }
    },
    "widget_unread_conversations %lld": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld conversation with unread messages"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld conversations with unread messages"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unterhaltung mit ungelesenen Nachrichten"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unterhaltungen mit ungelesenen Nachrichten"
                }
              }
            }
          }
        }
      }
    }
  },
  "version": "1.0"
}
