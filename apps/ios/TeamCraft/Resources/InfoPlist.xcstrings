{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft uses the camera for video calls, for photos you send and to scan the code of a new device you link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft verwendet die Kamera für Videoanrufe, für Fotos, die du sendest, und zum Scannen des Codes eines neuen Geräts, das du verknüpfst."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft uses Face ID to unlock the app when the app lock is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft verwendet Face ID zum Entsperren, wenn die App-Sperre an ist."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft uses the microphone for calls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft verwendet das Mikrofon für Anrufe."
          }
        }
      }
    }
  },
  "version": "1.0"
}
