{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft uses the camera for video calls, for photos you send and to scan the code of a new device you link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft verwendet die Kamera für Videoanrufe, für Fotos, die du sendest, und zum Scannen des Codes eines neuen Geräts, das du verknüpfst."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft uses Face ID to unlock the app when the app lock is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft verwendet Face ID zum Entsperren, wenn die App-Sperre an ist."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft saves pictures and videos you choose to your photo library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft speichert Bilder und Videos, die du auswählst, in deiner Fotomediathek."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft connects a call directly to the other device when you are on the same network, and asks your router to let a call's direct connection in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft verbindet einen Anruf direkt mit dem anderen Gerät, wenn ihr im selben Netzwerk seid, und bittet deinen Router, die direkte Verbindung eines Anrufs hereinzulassen."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft uses the microphone for calls and for voice messages you record."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft verwendet das Mikrofon für Anrufe und für Sprachnachrichten, die du aufnimmst."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft turns what others say in a call into captions, on this iPhone only: neither the audio nor the text leaves it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft macht aus dem, was andere in einem Anruf sagen, Untertitel – nur auf diesem iPhone: Weder Ton noch Text verlassen es."
          }
        }
      }
    }
  },
  "version": "1.0"
}
