      }
    },
    "attachment_unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden."
          }
        }
      }
    },
    "backup_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key backup"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel-Backup"
          }
        }
      }
    },
    "backup_ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keys are backed up"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schlüssel sind gesichert"
          }
        }
      }
    },
    "backup_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keys aren’t backed up yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schlüssel sind noch nicht gesichert"
          }
        }
      }
    },
    "backup_no_recovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery isn’t set up"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung ist nicht eingerichtet"
          }
        }
      }
    },
    "backup_missing_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a backup, a new device can’t read your earlier messages. Set a recovery passphrase on the desktop or web app to create one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Backup kann ein neues Gerät deine früheren Nachrichten nicht lesen. Lege in der Desktop- oder Web-App eine Wiederherstellungs-Passphrase fest, um eines anzulegen."
          }
        }
      }
    },
    "backup_no_recovery_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose all your devices, you can’t read your messages again. Set a recovery passphrase on the desktop or web app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du alle deine Geräte verlierst, kannst du deine Nachrichten nicht mehr lesen. Lege in der Desktop- oder Web-App eine Wiederherstellungs-Passphrase fest."
          }
        }
      }
    },
    "backup_passphrase": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery passphrase protects it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiederherstellungs-Passphrase schützt es."
          }
        }
      }
    },
    "backup_passphrase_set": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery passphrase protects it. You set it on %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiederherstellungs-Passphrase schützt es. Du hast sie am %@ festgelegt."
          }
        }
      }
    },
    "backup_organization": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
