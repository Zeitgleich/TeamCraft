    "call_status_sounds_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft tone repeats while your connection is lost; short tones tell when it is back or the call ended. Only you hear them, on the call's audio output."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leiser Ton wiederholt sich, solange deine Verbindung unterbrochen ist; kurze Töne zeigen, wenn sie wieder steht oder der Anruf beendet ist. Nur du hörst sie, über die Audioausgabe des Anrufs."
          }
        }
      }
    },
    "call_status_sounds_off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
