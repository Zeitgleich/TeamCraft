    "link_ask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask my other devices"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine anderen Geräte fragen"
          }
        }
      }
