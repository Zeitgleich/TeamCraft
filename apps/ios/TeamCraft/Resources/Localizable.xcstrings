    "store_damaged_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft's encrypted data on this device is damaged, or the key that opens it is gone. Your messages are not lost: set this device up again and unlock your keys with your recovery passphrase, or link it from another device. The old data is kept aside, not deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselten Daten von TeamCraft auf diesem Gerät sind beschädigt, oder der Schlüssel, der sie öffnet, fehlt. Deine Nachrichten sind nicht verloren: Richte dieses Gerät neu ein und entsperre deine Schlüssel mit deiner Wiederherstellungs-Passphrase oder verbinde es von einem anderen Gerät aus. Die alten Daten werden beiseitegelegt, nicht gelöscht."
          }
        }
      }
    },
    "store_newer_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data is from a newer TeamCraft"
          }
