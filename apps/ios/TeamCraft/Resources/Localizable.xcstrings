    "connection_captive_portal %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This network wants you to sign in first. Open a web page to sign in; messages wait. Next attempt in %lld s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Netzwerk verlangt zuerst eine Anmeldung. Öffne eine Webseite, um dich anzumelden; Nachrichten warten. Nächster Versuch in %lld s."
          }
        }
      }
    },
    "connection_untrusted_certificate %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's certificate isn't trusted. On a network that inspects encrypted traffic, use another network or ask your IT; if it happens everywhere, tell your administrator. Next attempt in %lld s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Zertifikat des Servers wird nicht vertraut. In einem Netzwerk, das verschlüsselten Verkehr prüft: Nutze ein anderes Netzwerk oder frag deine IT; passiert es überall, sag deiner Administration Bescheid. Nächster Versuch in %lld s."
          }
        }
      }
    },
