    "call_add_people": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add people"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen hinzufügen"
          }
        }
      }
    },
    "call_add_people_confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add and move the call"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen und Anruf verlegen"
          }
        }
      }
    },
    "call_add_people_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call moves into a new meeting room with everyone in it and the people you add. This conversation stays as it is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anruf wechselt in einen neuen Besprechungsraum mit allen Beteiligten und den Personen, die du hinzufügst. Diese Unterhaltung bleibt, wie sie ist."
          }
        }
      }
    },
    "call_add_people_none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nobody else you can add."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt niemanden, den du noch hinzufügen kannst."
          }
        }
      }
    },
    "call_camera_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft has no access to the camera. Allow it in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft hat keinen Zugriff auf die Kamera. Erlaube ihn in den Einstellungen."
