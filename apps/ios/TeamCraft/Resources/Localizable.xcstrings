    "voice_explain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record a voice message, TeamCraft needs the microphone. It is only used while you record, and the message is end-to-end encrypted like any file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Sprachnachricht braucht TeamCraft das Mikrofon. Es wird nur verwendet, während du aufnimmst, und die Nachricht ist wie jede Datei Ende-zu-Ende-verschlüsselt."
          }
        }
      }
    },
    "voice_continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "de": {
