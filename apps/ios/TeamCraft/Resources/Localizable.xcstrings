    },
    "link_code_for_new_device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is for the new phone: scan it there with Scan code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist für das neue Handy: Scanne ihn dort mit „Code scannen“."
          }
        }
      }
    },
    "link_code_for_signed_in_device": {
      "localizations": {
        "en": {
          "stringUnit": {
