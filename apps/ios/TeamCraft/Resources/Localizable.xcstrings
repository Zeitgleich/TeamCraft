          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie"
          }
        }
      }
    },
    "original_download_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An opened picture shows its preview at once. Otherwise its original loads when you tap “Load original”. Mobile data, hotspots and Low Data Mode don't count as Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein geöffnetes Bild zeigt sofort seine Vorschau. Sonst wird das Original geladen, wenn du auf „Original laden“ tippst. Mobile Daten, Hotspots und der Modus „Wenig Daten“ zählen nicht als WLAN."
          }
        }
      }
    },
    "join_requests_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests to join"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beitrittsanfragen"
          }
        }
      }
    },
    "join_request_summary %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ asks to join %2$@ as a workspace admin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ möchte %2$@ als Workspace-Admin beitreten"
          }
        }
      }
    },
    "join_request_summary_here %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks to join as a workspace admin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte als Workspace-Admin beitreten"
          }
        }
      }
    },
    "join_request_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving lets them read what is posted from now on, as joining by themselves would. Everybody in the channel sees that a workspace admin joined."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du zustimmst, kann die Person lesen, was ab jetzt geschrieben wird, wie bei einem Beitritt aus eigener Kraft. Alle im Kanal sehen, dass ein Workspace-Admin beigetreten ist."
          }
        }
      }
    },
    "join_request_owner_not_signed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other members wouldn’t accept an admin you let in: this device can’t confirm your owner role in this channel. Another channel owner or a workspace admin can approve, or set your role again. Until then you can only decline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Mitglieder würden einen von dir zugelassenen Admin nicht annehmen: Dieses Gerät kann deine Eigentümerrolle in diesem Kanal nicht bestätigen. Ein anderer Kanaleigentümer oder ein Workspace-Admin kann zustimmen oder deine Rolle neu setzen. Bis dahin kannst du nur ablehnen."
          }
        }
      }
    },
    "join_request_not_admin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed roster on this device doesn’t list them as a workspace admin, so you can only decline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die signierte Rollenliste auf diesem Gerät führt die Person nicht als Workspace-Admin, du kannst nur ablehnen."
          }
        }
      }
    },
    "join_request_approve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zustimmen"
          }
        }
      }
    },
    "join_request_decline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablehnen"
          }
        }
      }
    },
    "join_request_gone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request is no longer open: it was decided on another device or by another owner, withdrawn, or it expired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage ist nicht mehr offen: Sie wurde auf einem anderen Gerät oder von einem anderen Eigentümer entschieden, zurückgezogen oder ist abgelaufen."
          }
        }
      }
    },
    "join_ask_not_admin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device doesn’t have a current signed roster that lists you as a workspace admin yet. Try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gibt es noch keine aktuelle signierte Rollenliste, die dich als Workspace-Admin führt. Versuche es gleich noch einmal."
          }
        }
      }
    },
    "join_request_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your decision didn’t go through. Try again, or open TeamCraft."
          }
        },
