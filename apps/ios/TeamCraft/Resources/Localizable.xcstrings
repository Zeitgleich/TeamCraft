    "restore_link_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is already set up on another device. Link this phone from it: it's quickest, and your message history comes along."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto ist schon auf einem anderen Gerät eingerichtet. Verknüpfe dieses Telefon von dort: Das geht am schnellsten, und dein Nachrichtenverlauf kommt mit."
          }
        }
      }
    },
    "restore_passphrase_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other device at hand? Enter your recovery passphrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderes Gerät zur Hand? Gib deine Wiederherstellungs-Passphrase ein."
          }
        }
      }
    },
    "link_steps_phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your other phone: open TeamCraft, Settings → Devices → Link a device, and scan or enter this code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem anderen Telefon: TeamCraft öffnen, Einstellungen → Geräte → Gerät verknüpfen, und diesen Code scannen oder eingeben."
          }
        }
      }
    },
    "link_steps_computer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a computer: Settings → Devices and security → Link a new device, and enter this code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Computer: Einstellungen → Geräte und Sicherheit → Neues Gerät verknüpfen, und diesen Code eingeben."
          }
        }
      }
    },
    "notification_prompt_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't miss messages"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nachricht verpassen"
          }
        }
      }
    },
    "notification_prompt_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications to hear about direct messages, mentions and calls while TeamCraft is closed. Message content stays encrypted until it reaches this phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen, um bei Direktnachrichten, Erwähnungen und Anrufen benachrichtigt zu werden, auch wenn TeamCraft geschlossen ist. Inhalte bleiben verschlüsselt, bis sie auf diesem Telefon ankommen."
