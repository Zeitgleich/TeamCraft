      }
    },
    "connection_unreachable %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server can't be reached. Messages wait until it is back. Next attempt in %lld s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Nachrichten warten, bis er wieder da ist. Nächster Versuch in %lld s."
          }
        }
      }
    },
    "connection_captive_portal %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This network wants you to sign in first. Open a web page to sign in; messages wait. Next attempt in %lld s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Netzwerk verlangt zuerst eine Anmeldung. Öffne eine Webseite, um dich anzumelden; Nachrichten warten. Nächster Versuch in %lld s."
          }
        }
      }
    },
    "connection_untrusted_certificate %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's certificate isn't trusted. On a network that inspects encrypted traffic, use another network or ask your IT; if it happens everywhere, tell your administrator. Next attempt in %lld s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Zertifikat des Servers wird nicht vertraut. In einem Netzwerk, das verschlüsselten Verkehr prüft: Nutze ein anderes Netzwerk oder frag deine IT; passiert es überall, sag deiner Administration Bescheid. Nächster Versuch in %lld s."
          }
        }
      }
    },
    "connection_retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try now"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt versuchen"
          }
        }
      }
    },
    "connection_sign_in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Messages wait until you sign in again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Nachrichten warten, bis du dich wieder anmeldest."
          }
        }
      }
    },
    "connection_no_role_left": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has no TeamCraft role any more, so the server refuses everything. Ask an admin to give you one, then sign in again. Messages wait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto hat keine TeamCraft-Rolle mehr, deshalb lehnt der Server alles ab. Bitte einen Admin, dir eine zu geben, und melde dich danach erneut an. Nachrichten warten."
          }
        }
      }
    },
