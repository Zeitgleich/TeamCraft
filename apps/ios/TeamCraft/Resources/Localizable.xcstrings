    "store_reset_confirm_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft keeps the unreadable data beside the new data, so nothing is deleted, but this device starts empty and fills again from the server once you unlocked your keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft behält die unlesbaren Daten neben den neuen, es wird also nichts gelöscht, aber das Gerät startet leer und füllt sich wieder vom Server, sobald du deine Schlüssel entsperrt hast."
          }
        }
      }
    },
