    "join_request_notification_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a workspace admin. Approve shares only what is posted from now on; to share the earlier history, approve in the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Workspace-Admin. Zustimmen teilt nur, was ab jetzt geschrieben wird; um den bisherigen Verlauf zu teilen, stimme in der App zu."
          }
        }
      }
    },
    "join_request_notification_hidden_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request to join"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beitrittsanfrage"
          }
        }
      }
    },
    "join_request_notification_hidden_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace admin asks to join a channel you own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Workspace-Admin möchte einem deiner Kanäle beitreten."
          }
        }
      }
    },
    "join_request_hint_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving lets them read the earlier history too. Everybody in the channel sees that a workspace admin joined."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du zustimmst, kann die Person auch den bisherigen Verlauf lesen. Alle im Kanal sehen, dass ein Workspace-Admin beigetreten ist."
          }
        }
      }
    },
    "join_request_share_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also share the earlier history"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch den bisherigen Verlauf teilen"
          }
        }
      }
    },
    "join_ask_too_soon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked to join this channel recently, and that request was declined or withdrawn. You can ask again once it would have expired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast kürzlich angefragt, diesem Kanal beizutreten, und die Anfrage wurde abgelehnt oder zurückgezogen. Du kannst erneut anfragen, sobald sie abgelaufen wäre."
          }
        }
      }
    },
    "join_request_not_approvable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can’t approve this request: the signed policy no longer asks for an owner’s approval, or it isn’t a private channel you are in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann die Anfrage nicht annehmen: Die signierte Richtlinie verlangt keine Zustimmung eines Eigentümers mehr, oder es ist kein privater Kanal, in dem du bist."
          }
        }
      }
    },
    "link_phone_intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this phone from a device where you are already signed in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige dieses Handy auf einem Gerät, auf dem du schon angemeldet bist."
          }
        }
      }
    },
    "link_scan_code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code scannen"
          }
        }
      }
    },
    "link_scan_code_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a computer, open TeamCraft, then Settings, Devices and security, Link a new device: it shows a code for this phone to scan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf einem Computer TeamCraft, dann Einstellungen, Geräte und Sicherheit, Neues Gerät verknüpfen: Dort steht ein Code, den dieses Handy scannt."
          }
        }
      }
    },
    "link_no_other_device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only signed in on another phone? Ask your other devices: the phone shows the prompt too. No other device at all? Go back and use your recovery key or organization recovery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf einem anderen Handy angemeldet? Frag deine anderen Geräte: Auch das Handy zeigt die Anfrage. Gar kein anderes Gerät? Geh zurück und nutze deinen Wiederherstellungsschlüssel oder die Wiederherstellung durch die Organisation."
          }
        }
      }
    },
    "link_expired_restarted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request or code ran out. Ask your devices again, or scan a new code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage oder der Code ist abgelaufen. Frag deine Geräte erneut oder scanne einen neuen Code."
          }
        }
      }
    },
    "link_code_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a TeamCraft link code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein TeamCraft-Verknüpfungscode."
          }
        }
