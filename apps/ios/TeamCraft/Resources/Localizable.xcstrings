    "scheduled_status_policy_off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workspace turned scheduling off. It stays here until you send or cancel it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Workspace hat geplante Nachrichten abgeschaltet. Sie bleibt hier, bis du sie sendest oder verwirfst."
          }
        }
      }
    },
    "scheduled_status_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your app can't tell what happens to this message. Update it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine App kann nicht sagen, was mit dieser Nachricht passiert. Aktualisiere sie."
