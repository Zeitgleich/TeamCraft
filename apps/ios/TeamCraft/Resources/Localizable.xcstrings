    "link_ask_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of scanning, your other devices show a prompt. The server then sees the key in this code; you still type the code shown here on the other device, so nothing is approved without you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt zu scannen zeigen deine anderen Geräte eine Anfrage. Der Server sieht dann den Schlüssel in diesem Code; du gibst den hier angezeigten Code trotzdem auf dem anderen Gerät ein, ohne dich wird also nichts bestätigt."
          }
        }
      }
    },
    "link_asked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other devices show a prompt now."
