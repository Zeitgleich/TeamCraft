        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An opened picture shows its preview at once. Otherwise its original loads when you tap “Load original”. Mobile data, hotspots and Low Data Mode don't count as Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein geöffnetes Bild zeigt sofort seine Vorschau. Sonst wird das Original geladen, wenn du auf „Original laden“ tippst. Mobile Daten, Hotspots und der Modus „Wenig Daten“ zählen nicht als WLAN."
          }
        }
