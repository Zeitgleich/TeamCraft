    "settings_scheduled_summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages waiting to be sent later"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten, die später rausgehen"
          }
        }
      }
    },
    "scheduled_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server keeps these, encrypted, and sends them on time, even with your devices off. If the group changes (someone joins or leaves), a device of yours must update the encryption first. This iPhone tries in the background, but iOS may delay it or skip it; then a message waits for one of your devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hebt sie verschlüsselt auf und sendet sie pünktlich, auch wenn deine Geräte aus sind. Ändert sich die Gruppe (jemand kommt dazu oder geht), muss zuerst eines deiner Geräte die Verschlüsselung erneuern. Dieses iPhone versucht das im Hintergrund, iOS kann es aber verzögern oder auslassen; dann wartet eine Nachricht auf eines deiner Geräte."
          }
        }
      }
    },
    "scheduled_empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing scheduled. Use \"Send later\" behind the paperclip in the composer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts geplant. Nutze „Später senden“ hinter der Büroklammer im Eingabefeld."
          }
        }
      }
    },
    "scheduled_unknown_conversation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown conversation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte Unterhaltung"
          }
        }
