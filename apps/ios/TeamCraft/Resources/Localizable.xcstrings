    "scheduled_attention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A scheduled message needs you"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geplante Nachricht braucht dich"
          }
        }
      }
    },
    "scheduled_status_needs_sealing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group changed. One of your devices updates the encryption by itself; it goes out on time if one does in time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe hat sich geändert. Eines deiner Geräte erneuert die Verschlüsselung von selbst; schafft es das rechtzeitig, geht sie pünktlich raus."
          }
        }
      }
    },
    "scheduled_status_stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late: the group changed and none of your devices got to it. It goes out as soon as one does."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verspätet: Die Gruppe hat sich geändert, und keines deiner Geräte kam dazu. Sie geht raus, sobald eines es tut."
          }
        }
      }
    },
    "scheduled_status_not_a_member": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're no longer in this conversation, so it won't go out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht mehr in dieser Unterhaltung, deshalb geht sie nicht raus."
          }
        }
      }
    },
    "scheduled_status_no_permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may no longer post in this conversation, so it didn't go out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst hier nicht mehr schreiben, deshalb ging sie nicht raus."
          }
        }
      }
    },
    "scheduled_status_conversation_gone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation was deleted, so it won't go out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung wurde gelöscht, deshalb geht sie nicht raus."
          }
        }
      }
    },
    "scheduled_status_thread_gone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thread it answers is gone, so it didn't go out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Thread, auf den sie antwortet, gibt es nicht mehr, deshalb ging sie nicht raus."
          }
        }
      }
    },
    "scheduled_status_unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can't read it yet. It still goes out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann sie noch nicht lesen. Sie geht trotzdem raus."
          }
        }
      }
    },
    "scheduled_status_removed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server removed it after holding it this long, so it won't go out. The text is only on your devices now: copy it if you still need it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat sie nach dieser langen Zeit entfernt, deshalb geht sie nicht raus. Der Text ist jetzt nur noch auf deinen Geräten: Kopiere ihn, falls du ihn noch brauchst."
          }
        }
      }
    },
    "scheduled_removal_date %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server removes it on %@. Copy the text before then if you need it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server entfernt sie am %@. Kopiere den Text vorher, falls du ihn brauchst."
          }
        }
      }
    },
    "scheduled_dismiss": {
      "localizations": {
        "en": {
