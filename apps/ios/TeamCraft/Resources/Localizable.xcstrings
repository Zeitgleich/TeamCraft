            "state": "translated",
            "value": "Weiter"
          }
        }
      }
    },
    "voice_permission_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft may not use the microphone. Allow it in Settings > TeamCraft > Microphone, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft darf das Mikrofon nicht verwenden. Erlaube es unter Einstellungen > TeamCraft > Mikrofon und versuche es dann noch einmal."
          }
        }
      }
    },
    "voice_open_settings": {
