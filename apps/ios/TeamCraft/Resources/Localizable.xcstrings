{
  "sourceLanguage": "en",
  "strings": {
    "animated_images_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animated images"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animierte Bilder"
          }
        }
      }
    },
    "animated_images_autoplay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch"
          }
        }
      }
    },
    "animated_images_tap": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On tap"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Tippen"
          }
        }
      }
    },
    "animated_images_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs and other moving pictures. Automatic fetches them like original images (see above). With Reduce Motion on in the system settings, they don't start by themselves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs und andere bewegte Bilder. „Automatisch“ lädt sie wie Originalbilder (siehe oben). Ist „Bewegung reduzieren“ in den Systemeinstellungen an, starten sie nicht von selbst."
          }
        }
      }
    },
    "animation_play": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play animation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation abspielen"
          }
        }
      }
    },
    "animation_pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause animation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation anhalten"
          }
        }
      }
    },
    "animation_state_playing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animated image, playing"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiertes Bild, wird abgespielt"
          }
        }
      }
    },
    "animation_state_paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animated image, paused"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiertes Bild, angehalten"
          }
        }
      }
    },
    "animation_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't load"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht geladen"
          }
        }
      }
    },
    "video_unplayable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video can't be played on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video kann auf diesem Gerät nicht abgespielt werden."
          }
        }
      }
    },
    "video_open_elsewhere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in another app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In anderer App öffnen"
          }
        }
      }
    },
    "browse_show_archived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show archived channels I'm in"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Kanäle anzeigen, in denen ich bin"
          }
        }
      }
    },
    "guest_notice_extend %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more days"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage mehr"
          }
        }
      }
    },
    "guest_notice_extend_until %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %@"
          }
        }
      }
    },
    "guest_notice_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't extend the guest. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gast konnte nicht verlängert werden. Versuch es noch einmal."
          }
        }
      }
    },
    "guest_notice_row %@ %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@, until %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@, bis %3$@"
          }
        }
      }
    },
    "guest_notice_self %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your guest access to %1$@ ends on %2$@. Ask the person who invited you to extend it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gastzugang zu %1$@ endet am %2$@. Bitte die Person, die dich eingeladen hat, ihn zu verlängern."
          }
        }
      }
    },
    "guest_notice_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guest access ending soon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastzugänge laufen bald ab"
          }
        }
      }
    },
    "read_only_archived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This channel is archived. You can read it, but nobody can post here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kanal ist archiviert. Du kannst ihn lesen, aber niemand kann hier schreiben."
          }
        }
      }
    },
    "section_archived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviert"
          }
        }
      }
    },
    "video_loading %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the video (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video wird geladen (%@)"
          }
        }
      }
    },
    "server_confirm_from_link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn't enter this server: a link brought you here. Signing in gives this server access to your account. Continue only if you trust it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diesen Server nicht eingegeben: Ein Link hat dich hierher gebracht. Mit der Anmeldung bekommt dieser Server Zugriff auf dein Konto. Fahre nur fort, wenn du ihm vertraust."
          }
        }
      }
    },
    "app_link_foreign_add %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nYou didn't enter this server: a link brought you here, and this app has no account yet. Signing in gives this server access to your account, so sign in only if you trust it. Otherwise open the link in the browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nDu hast diesen Server nicht eingegeben: Ein Link hat dich hierher gebracht, und diese App hat noch kein Konto. Mit der Anmeldung bekommt dieser Server Zugriff auf dein Konto. Melde dich also nur an, wenn du ihm vertraust. Sonst öffne den Link im Browser."
          }
        }
      }
    },
    "app_link_foreign_other %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThis link leads to another server, not the one this app is signed in to. The app holds one account at a time, so it can only open this link in the browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nDieser Link führt zu einem anderen Server, nicht zu dem, an dem diese App angemeldet ist. Die App hat immer nur ein Konto und kann den Link daher nur im Browser öffnen."
          }
        }
      }
    },
    "app_link_meeting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app shows the meetings you are invited to. If this one isn't among them, the browser can ask its hosts to let you in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App zeigt die Meetings, zu denen du eingeladen bist. Ist dieses nicht dabei, kann der Browser die Hosts bitten, dich einzulassen."
          }
        }
      }
    },
    "app_link_meeting_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting link"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting-Link"
          }
        }
      }
    },
    "app_link_my_meetings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My meetings"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Meetings"
          }
        }
      }
    },
    "app_link_open_browser": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in browser"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Browser öffnen"
          }
        }
      }
    },
    "app_link_sign_in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in there"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort anmelden"
          }
        }
      }
    },
    "app_link_web_only %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThis link only works in the browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nDieser Link funktioniert nur im Browser."
          }
