    },
    "scheduled_dismiss_question": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove it from this device? Its text is gone from here then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Gerät entfernen? Der Text ist dann hier weg."
          }
        }
