    "enroll_new_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a recovery passphrase. It protects your key backup; without it (or another device) your message history can't be restored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Wiederherstellungs-Passphrase. Sie schützt dein Schlüssel-Backup; ohne sie (oder ein anderes Gerät) lässt sich dein Nachrichtenverlauf nicht wiederherstellen."
          }
        }
      }
    },
    "enroll_recover_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account already has encryption keys. Enter your recovery passphrase, or link this phone from a device you're signed in on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto hat bereits Verschlüsselungsschlüssel. Gib deine Wiederherstellungs-Passphrase ein oder verknüpfe dieses Telefon über ein Gerät, auf dem du angemeldet bist."
          }
        }
      }
    },
