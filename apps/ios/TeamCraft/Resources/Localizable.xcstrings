    "store_damaged_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data on this device can't be read"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten auf diesem Gerät können nicht gelesen werden"
          }
        }
      }
    },
    "store_damaged_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft's encrypted data on this device is damaged, or the key that opens it is gone. Your messages are not lost: set this device up again and unlock your keys with your recovery passphrase, or link it from another device. The old data is kept aside, not deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselten Daten von TeamCraft auf diesem Gerät sind beschädigt, oder der Schlüssel, der sie öffnet, fehlt. Deine Nachrichten sind nicht verloren: Richte dieses Gerät neu ein und entsperre deine Schlüssel mit deiner Wiederherstellungs-Passphrase oder verbinde es von einem anderen Gerät aus. Die alten Daten werden beiseitegelegt, nicht gelöscht."
          }
        }
      }
    },
    "store_newer_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data is from a newer TeamCraft"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten stammen von einem neueren TeamCraft"
          }
        }
      }
    },
    "store_newer_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer version of TeamCraft changed the data on this device, and this version can't read it. Update TeamCraft to the newest version, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Version von TeamCraft hat die Daten auf diesem Gerät geändert, und diese Version kann sie nicht lesen. Aktualisiere TeamCraft auf die neueste Version und versuche es dann erneut."
          }
        }
      }
    },
    "store_reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up this device again"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät neu einrichten"
          }
        }
      }
    },
    "store_reset_confirm_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set this device up again?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät neu einrichten?"
          }
        }
      }
    },
    "store_reset_confirm_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft keeps the unreadable data beside the new data, so nothing is deleted, but this device starts empty and fills again from the server once you unlocked your keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TeamCraft behält die unlesbaren Daten neben den neuen, es wird also nichts gelöscht, aber das Gerät startet leer und füllt sich wieder vom Server, sobald du deine Schlüssel entsperrt hast."
          }
        }
      }
    },
    "store_reset_confirm_button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, set up again"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, neu einrichten"
          }
        }
      }
    },
