    },
    "voice_busy_elsewhere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voice message waits in another conversation. Send or discard it first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer anderen Unterhaltung wartet eine Sprachnachricht. Sende oder verwirf sie zuerst."
