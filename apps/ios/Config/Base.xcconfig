// Shared build settings (project.yml -> configFiles). Override per machine in Config/Local.xcconfig
// (untracked), e.g. DEVELOPMENT_TEAM and a default server for your own builds.
#include? "Local.xcconfig"

// No server is built in: the user enters it at the first start, or the device's management sets it
// (README.md "Server address"). Info.plist reads these (see Shared/AppEnvironment.swift).
// Optional default server for self-built apps, offered at the first start (the user can change it),
// e.g. https:/$()/team.example.com. Empty in published builds.
TEAMCRAFT_DEFAULT_SERVER_URL =
// The push gateway the APNs token is sealed for (the publisher's, e.g. https:/$()/push-gw.zeitgleich.de); empty:
// the gateway the server names (self-built apps).
TEAMCRAFT_PUSH_GATEWAY_URL =
// Redirect URI is <scheme>:/oauth/callback; the OIDC client must allow it.
TEAMCRAFT_OIDC_REDIRECT_SCHEME = de.zeitgleich.teamcraft

// Shared between the app and the notification service extension (docs/e2ee.md §7).
APP_GROUP_ID = group.de.zeitgleich.teamcraft
KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)de.zeitgleich.teamcraft

// Entitlements of the extension. Swap for NotificationService.Filtering.entitlements once Apple granted
// com.apple.developer.usernotifications.filtering (needed to suppress call pushes, README.md).
NSE_ENTITLEMENTS = NotificationService/NotificationService.entitlements
// YES together with the Filtering entitlements above: the extension then drops muted and duplicate
// pushes and hands calls to CallKit; NO shows them quietly and calls as an incoming-call alert.
NSE_NOTIFICATION_FILTERING = NO

// APNs environment of the push entitlement (archives for TestFlight/App Store get production from the profile).
APS_ENVIRONMENT = development
