# The GStreamer packages CI and the release build install: the one place their version and hashes
# are pinned. scripts/fetch-gstreamer.sh reads it. To bump: change the version and hashes here, then
# mirror the new files into the `ci-deps` release (docs/release.md, "CI dependency mirror").
GSTREAMER_VERSION=1.28.8
GSTREAMER_SHA256_WINDOWS_MSVC=e4c41ee6ee9c6c32a45d198463ec08d79bac3bd5fa58adc93d13fe4a08abc9d9
GSTREAMER_SHA256_MACOS_RUNTIME=d371ab04a7632713626836c2fc234e863cc98484c74c473eba99b0fbd9b3a3fe
GSTREAMER_SHA256_MACOS_DEVEL=e6d380bc17be7eccf13e0154567d4718fc9321da822408c7ca0cd808b3d4a3f7
